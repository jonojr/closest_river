# Root .env for a test site on the same host as production.
#
# Copy to .env at the root of the test site's checkout (a separate clone from
# production's, on the branch under test) and fill in the blanks. Compose reads
# it for the ${...} values in docker-compose.production.yml; Django never reads
# it. Every value below defaults to production's when unset, which on a shared
# host means overwriting production — so set all of them.

# Containers, networks and named volumes are prefixed with this. If it matched
# production's, `up` would REPLACE production's containers.
COMPOSE_PROJECT_NAME=closest_river_test

# Image tags. If these matched, building the test site would retag production's
# images, and production's next restart would run the test code.
IMAGE_PREFIX=closest_river_test

# Postgres data, backups, media and the OSM working files. If this matched,
# the test Postgres would start on production's data directory — and
# migration 0004 drops the old river tables.
DATA_DIR=/mnt/Data/closest_river_test

# Django's env files for the test site; see .envs/.production for the shape.
# In .django, set at least:
#   DJANGO_ALLOWED_HOSTS=<test host name>
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://<test host name>
#   VECTOR_TILES_URLS=https://<test host name>
#   OSM_PLANET_URL=https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf
# and its own DJANGO_SECRET_KEY, DJANGO_ADMIN_URL and Flower credentials.
# .postgres needs its own password; its POSTGRES_HOST stays `postgres`, which
# resolves inside the test project's own network.
ENVS_DIR=./.envs/.test

# Host ports, clear of production's 5000, 5001 and 5555. Point the reverse
# proxy for the test host name at DJANGO_HOST_PORT.
DJANGO_HOST_PORT=5100
NGINX_HOST_PORT=5101
FLOWER_HOST_PORT=5655

# Baked into the map JS at build time. The same key as production is fine.
MAPTILER_API_KEY=

# Production's defaults assume the box is Postgres's alone (about 16 GB); the
# test site shares it with production, and a regional extract needs far less.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_MAX_WAL_SIZE=2GB
REDIS_CACHE_MAXMEMORY=512mb
